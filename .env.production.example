# Production environment for the PUBLIC DEMO (Vercel for apps/web, Fly.io for workers/runner).
#
# Copy the lines you need into the Vercel project (Settings > Environment Variables, Production scope) and into the Fly
# worker (fly secrets import, or [env] in fly.toml for non-secret values). Never commit a filled-in copy.
# Every value below is empty except the fixed demo policy values, which are the ONLY non-empty values allowed here.
# A filled-in secret must never be committed: this file is the reference, not the store.
#
# Lines starting with # are comments and are not read by the app. Keep dev-only switches commented out.
# HIRELANE_DEMO=1 is NOT read by the web app. It only gates the local seed script (pnpm demo:seed). Never set it on Vercel or Fly.
# HIRELANE_SAMPLES=1 opens every /dev page. Never set it in production.
# HIRELANE_INSECURE_DEV_COOKIE, HIRELANE_FAULTS: never set in production.

# ---- Runtime -------------------------------------------------------------------------------------------------------------
# Vercel sets this to production itself; the worker image and fly.toml set it too. Production behaviour is fail-closed.
NODE_ENV=production

# ---- Database (Neon Postgres) --------------------------------------------------------------------------------------------
# Neon connection string, direct (not pooled) for migrations. Keep sslmode=require. Secret: contains the password.
DATABASE_URL=

# ---- Secrets and keys ----------------------------------------------------------------------------------------------------
# Master key for envelope encryption and every HMAC (campus join codes, mailbox hashes). Generate once with `pnpm setup:keys`
# (it prints the line). It MUST be identical on Vercel and Fly and in the local seed. Never rotate it casually: stored data depends on it.
HIRELANE_MASTER_KEY=
# Gates /ops/ingest. Any long random string (for example: openssl rand -hex 32). Secret.
HIRELANE_OPS_TOKEN=

# ---- Public origin -------------------------------------------------------------------------------------------------------
# Public https origin of the web app, no trailing slash, e.g. https://demo.example.com. Used for OAuth redirects and links.
HIRELANE_APP_ORIGIN=
# Same origin. The sitemap, robots.txt and openapi.json read THIS name (not HIRELANE_APP_ORIGIN); unset, they point at localhost.
APP_ORIGIN=

# ---- Apply addresses and mail ---------------------------------------------------------------------------------------------
# Domain of every student's apply address (handle.tag@domain). Addresses are permanent. Must be a real domain in production.
HIRELANE_APPLY_DOMAIN=
# authserv-id of our receiving MTA. Only the inbound scan reads it (the worker). Required in production.
HIRELANE_MAIL_AUTHSERV_ID=
# Blob root for uploaded resumes, one ABSOLUTE path shared by web and worker. Required in production. Leave empty on Vercel
# (no shared disk there): resume upload is not demo-safe until a shared blob store exists. See docs/DEPLOY-DEMO.md.
HIRELANE_STORAGE_DIR=

# ---- Auto-apply, LLM, ingest (demo policy: fixture, offline, zero LLM calls) ----------------------------------------------
# off | fixture | live. Demo: fixture only. The executor refuses every real host, so no live employer submission is possible.
HIRELANE_AUTO_APPLY=fixture
# anthropic | fixture | off. Demo: off. With off, no call leaves the process.
HIRELANE_LLM_MODE=off
# Must stay EMPTY for the demo. A key here lets the app call the model API (which the demo must not do).
ANTHROPIC_API_KEY=
# Model names, used only in anthropic mode. Empty = app defaults. Unused while HIRELANE_LLM_MODE=off.
HIRELANE_MODEL_DRAFT=
HIRELANE_MODEL_BULK=
# fixture | live. Demo: fixture (recorded fixtures, no ATS calls).
HIRELANE_INGEST_MODE=fixture

# ---- Accounts and sign-in ------------------------------------------------------------------------------------------------
# 1 forces sign-in on, 0 forces it off, empty = the feature_flags row 'accounts' decides (default off).
# Email-code sign-in needs a production mail transport, which does not exist yet: use Google or LinkedIn for the demo.
HIRELANE_ACCOUNTS=
# Google OpenID Connect. Both must be set or the button is hidden. Redirect URI to register: <APP_ORIGIN>/auth/google/callback
HIRELANE_GOOGLE_CLIENT_ID=
HIRELANE_GOOGLE_CLIENT_SECRET=
# Optional override of the issuer. Empty = https://accounts.google.com
HIRELANE_OIDC_ISSUER=
# LinkedIn OpenID Connect. Both must be set or the button is hidden. Redirect URI: <APP_ORIGIN>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional override of the LinkedIn issuer. Empty = the built-in default.
HIRELANE_LINKEDIN_ISSUER=

# ---- Client identity behind Vercel (rate limits) -------------------------------------------------------------------------
# Vercel's edge overwrites any client-sent x-real-ip, so trust it. Proxy depth 1 for Vercel.
TRUST_X_REAL_IP=1
TRUST_PROXY_HOPS=1

# ---- Company logos (worker) ----------------------------------------------------------------------------------------------
# Directory for company logo files. Empty = the repo's storage/logos (ephemeral on Fly). Set to a path on the worker's volume to keep them.
HIRELANE_LOGO_DIR=
