# Copy to .env.local. Never commit real values.
DATABASE_URL=postgres://hirelane:hirelane@localhost:5433/hirelane
TEST_DATABASE_URL=postgres://hirelane:hirelane@localhost:5433/hirelane_test

# LLM (PLAN 5.3): auto | live | fixture | off
HIRELANE_LLM_MODE=auto
ANTHROPIC_API_KEY=
HIRELANE_MODEL_DRAFT=claude-opus-5-5
HIRELANE_MODEL_BULK=claude-opus-5-5
# hash | local
HIRELANE_EMBEDDINGS=hash

# Ingest: fixture | live
HIRELANE_INGEST_MODE=fixture

# Security (PLAN 10). Generate dev values with `pnpm setup:keys`.
HIRELANE_MASTER_KEY=
HIRELANE_OPS_TOKEN=

# Blob storage root for uploaded resumes. REQUIRED in production, as one ABSOLUTE path shared by the web app and the runner
# (startup fails closed otherwise). Outside production it defaults to <repo>/storage.
HIRELANE_STORAGE_DIR=
# Public origin of the web app (OAuth redirect URIs, links in email), e.g. https://app.example.com
HIRELANE_APP_ORIGIN=http://localhost:3001
# Domain of every student's apply address (handle+tag@domain). REQUIRED in production once auto-apply is not off; addresses are permanent.
HIRELANE_APPLY_DOMAIN=apply.localhost
# Authserv-id of our own MTA, the only Authentication-Results header inbound:scan trusts.
HIRELANE_MAIL_AUTHSERV_ID=
# Auto-apply: off | fixture | live. Unset means off in production and fixture elsewhere. Keep off until the notice copy and consent text are updated.
HIRELANE_AUTO_APPLY=
# Accounts (sign-in, resumes, campus). Enabling it in production needs a real mail transport (the file outbox refuses to run).
HIRELANE_ACCOUNTS=
# Fault injection for tests, e.g. board:500:<token>
HIRELANE_FAULTS=

# Rate limiting / client identity (public API, waitlist, board actions). Order of precedence:
#  1. x-real-ip, if valid, ONLY when TRUST_X_REAL_IP=1. Enable it only if your edge overwrites any client-sent value (Vercel does).
#  2. TRUST_PROXY_HOPS: how many trusted reverse proxies append to X-Forwarded-For (0 = never read it).
#     Use 1 behind one proxy that appends the client address.
#  3. In production with neither, clients are bucketed by a hash of user-agent + accept-language (weak; configure 1 or 2).
#     In development/test they share a "local" key with a widened budget.
TRUST_PROXY_HOPS=0
TRUST_X_REAL_IP=0

# Sign in with LinkedIn (OpenID Connect). Both must be set or the button is hidden and the routes answer 503.
# Redirect URI to register: <HIRELANE_APP_ORIGIN>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
