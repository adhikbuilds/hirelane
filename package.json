{
  "name": "hirelane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @hirelane/web dev",
    "worker": "pnpm --filter @hirelane/runner start",
    "test": "pnpm -r --if-present test",
    "test:scripts": "vitest run --root scripts",
    "e2e": "playwright test -c apps/web/playwright.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint:deps": "depcruise packages apps workers --config .dependency-cruiser.cjs",
    "brand-guard": "vite-node scripts/brand-guard.ts",
    "no-submit-guard": "vite-node scripts/no-submit-guard.ts",
    "withadmin-guard": "vite-node scripts/withadmin-guard.ts",
    "verify": "pnpm test && pnpm typecheck && pnpm lint:deps && pnpm brand-guard && pnpm no-submit-guard && pnpm withadmin-guard && pnpm engine:eval && pnpm db:verify-schema && pnpm db:verify-rls && pnpm db:verify-auth",
    "setup:keys": "pnpm --filter @hirelane/vault --silent setup:keys",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hirelane/db migrate",
    "db:seed": "pnpm --filter @hirelane/db seed",
    "db:reset": "pnpm --filter @hirelane/db reset",
    "db:fresh": "pnpm db:reset && pnpm db:migrate && pnpm db:seed",
    "db:verify-rls": "pnpm --filter @hirelane/db verify-rls",
    "db:verify-auth": "pnpm --filter @hirelane/db verify-auth",
    "db:verify-schema": "pnpm --filter @hirelane/db verify-schema",
    "ingest:run": "pnpm --filter @hirelane/ingest ingest:run",
    "ingest:record": "pnpm --filter @hirelane/ingest record",
    "engine:eval": "pnpm --filter @hirelane/engine eval",
    "agent:eval": "echo \"agent:eval: not implemented until Phase 4\"",
    "enrich:run": "pnpm --filter @hirelane/runner enrich:run",
    "report:coverage": "vite-node scripts/report-coverage.ts --",
    "bench:board": "vite-node scripts/bench-board.ts",
    "budget": "vite-node scripts/js-budget.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.6.0",
    "typescript": "^5.9.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.3"
    }
  }
}
